{
  "version": 1,
  "hooks": {
    "agentStop": [
      {
        "powershell": "pwsh -NoProfile -File '${PLUGIN_ROOT}\\hooks\\Hook-AgentStop.ps1'",
        "timeoutSec": 10,
        "type": "command"
      },
      {
        "powershell": "pwsh -NoProfile -File '${PLUGIN_ROOT}\\hooks\\Hook-AgentStopSound.ps1'",
        "timeoutSec": 10,
        "type": "command"
      }
    ],
    "notification": [
      {
        "matcher": "permission_prompt",
        "powershell": "pwsh -NoProfile -File '${PLUGIN_ROOT}\\hooks\\Show-FocusToast.ps1'",
        "timeoutSec": 20,
        "type": "command"
      }
    ],
    "preToolUse": [
      {
        "matcher": "ask_user",
        "powershell": "pwsh -NoProfile -File '${PLUGIN_ROOT}\\hooks\\Hook-AskUserToast.ps1'",
        "timeoutSec": 15,
        "type": "command"
      }
    ]
  }
}
